      "label": "Labels / abstentions",
      "role": "main"
    },
    {
      "from": "score",
      "to": "review",
      "label": "Scores + changes",
      "role": "branch"
    },
    {
      "from": "score",
      "to": "gate",
      "label": "Retained evidence",
      "role": "main"
    },
    {
      "from": "gate",
      "to": "merge",
      "label": "Pass",
      "role": "main"
    },
    {
      "from": "gate",
      "to": "change",
      "label": "Fix or revise",
      "role": "return"
    },
    {
      "from": "gate",
      "to": "exception",
      "label": "Eligible regression",
      "role": "branch"
    },
    {
      "from": "exception",
      "to": "merge",
      "label": "Recorded acceptance",
      "role": "branch"
    },
    {
      "from": "merge",
      "to": "mainbuild",
      "label": "CI on main",
      "role": "main"
    },
    {
      "from": "mainbuild",
      "to": "integration",
      "label": "Promote release",
      "role": "branch"
    },
    {
      "from": "integration",
      "to": "staging",
      "label": "Verified",
      "role": "main"
    },
    {
      "from": "staging",
      "to": "load",
      "label": "Candidate vs baseline",
      "role": "main"
    },
    {
      "from": "load",
      "to": "production",
      "label": "Passed + approved",
      "role": "main"
    }
