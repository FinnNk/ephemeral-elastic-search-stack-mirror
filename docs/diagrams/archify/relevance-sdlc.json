  "mainPath": [
    "change",
    "pr",
    "build",
    "apis",
    "labels",
    "score",
    "gate",
    "merge",
    "mainbuild"
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Reproducible comparisons",
      "items": [
        "Use the same queries and catalogue with pinned baseline and candidate APIs. Compatible indexes may be shared.",
        "Pool missing labels across variants; reuse predictions and abstentions. Freeze one label set for scoring."
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence before merge",
      "items": [
        "Review nDCG, RBO, Jaccard, coverage and timing. Extra query sets have separate and combined reports.",
        "Each selected variant must pass or have an eligible Git decision. Invalid evidence stays blocked."
      ]
    },
    {
      "dot": "amber",
      "title": "One merged build, three targets",
      "items": [
        "Actions evaluates, creates a reviewed delivery-state PR and merges approved state. Argo CD deploys; the API is verified.",
        "Production requires normal/peak Gatling load on previews. Rollback rechecks a retained release through the same reviewed process."
      ]
    }
  ]
}
