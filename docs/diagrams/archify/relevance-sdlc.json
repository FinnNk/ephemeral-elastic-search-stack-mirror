  "edges": [
    {
      "from": "change",
      "to": "pr",
      "label": "Push",
      "role": "main"
    },
    {
      "from": "pr",
      "to": "build",
      "label": "Exact head",
      "role": "main"
    },
    {
      "from": "build",
      "to": "apis",
      "label": "Deploy previews",
      "role": "main"
    },
    {
      "from": "apis",
      "to": "labels",
      "label": "Fresh API results",
      "role": "main"
    },
    {
      "from": "labels",
