  "cards": [
    {
      "dot": "cyan",
      "title": "One reproducible comparison",
      "items": [
        "Baseline and candidate definitions are pinned; compatible indexes may be shared.",
        "All variants use one frozen judgement set. Scores and judgement coverage remain separate."
      ]
    },
    {
      "dot": "amber",
      "title": "If the source gate fails",
      "items": [
        "Rejected regressions and hard blocks require a new commit and fresh comparison.",
        "Only eligible bounded regressions can be accepted. The reviewed Git decision retains the original scores."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reviewed deployment and recovery",
      "items": [
        "Each promotion requires fresh evidence for the exact release, target and intent. Failed gates block promotion.",
        "Use Actions for each target. A separate reviewer approves the exact delivery-state PR before merge and deployment verification.",
        "Rollback re-evaluates a retained release through the same reviewed process."
      ]
    },
    {
      "dot": "cyan",
      "title": "Timing key",
      "items": [
        "Warm runs only: retained images, compatible index and reused judgements; 1,000 queries and two APIs.",
        "Build times are targets; deployment times are SLOs. Other estimates are labelled or explained in the linked timing key.",
        "Review and queueing time are additional. Stage height does not represent duration."
      ]
    }
