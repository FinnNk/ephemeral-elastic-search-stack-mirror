      "label": "Variant results",
      "sublabel": "IDs + errors",
      "stage": 2,
      "row": 2,
      "type": "frontend"
    },
    {
      "id": "judgements",
      "label": "Judgements",
      "sublabel": "Selected manifest SHA",
      "stage": 3,
      "row": 0,
      "type": "database"
    },
    {
      "id": "evaluator",
