      "sublabel": "Ordered product IDs",
      "stage": 2,
      "row": 2,
      "type": "frontend"
    },
    {
      "id": "judgements",
      "label": "Judgements",
      "sublabel": "Same frozen ratings",
      "stage": 3,
      "row": 0,
      "type": "database"
    },
    {
      "id": "evaluator",
