  "flows": [
    {
      "from": "baseline",
      "to": "baselineapi",
      "label": "Pinned inputs",
      "route": "straight"
    },
    {
      "from": "candidate",
      "to": "candidateapi",
      "label": "Pinned inputs",
      "route": "straight"
    },
    {
      "from": "queries",
      "to": "baselineapi",
      "label": "Original requests",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "via": [
        [
          100,
          214
        ],
        [
          315,
          214
        ]
      ]
    },
    {
      "from": "queries",
      "to": "candidateapi",
      "label": "Original requests",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "via": [
        [
          100,
          328
        ],
        [
          315,
          328
        ]
      ]
    },
    {
      "from": "baselineapi",
      "to": "baselineresults",
      "label": "Final rankings",
      "variant": "emphasis"
    },
    {
      "from": "candidateapi",
      "to": "candidateresults",
      "label": "Final rankings",
      "variant": "emphasis"
    },
    {
      "from": "baselineresults",
      "to": "evaluator",
      "label": "Baseline results",
      "variant": "emphasis"
    },
    {
      "from": "candidateresults",
      "to": "evaluator",
      "label": "All variant results",
      "variant": "emphasis"
    },
    {
      "from": "judgements",
      "to": "evaluator",
      "label": "Grades",
      "labelDy": 35
    },
    {
      "from": "evaluator",
      "to": "report",
      "label": "Scores + deltas",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "Pin environments and input versions",
      "items": [
        "Default and baseline are named separately",
        "APIs may share a frozen environment"
      ]
    },
    {
      "dot": "emerald",
      "title": "Score again without another search",
      "items": [
        "Keep ordered results and fingerprints",
        "Pool judgements across all variants"
      ]
    }
  ]
