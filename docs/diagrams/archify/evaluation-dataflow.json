{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Compare relevance across frozen environments",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      620
    ]
  },
  "stages": [
    {
      "label": "Frozen definitions"
    },
    {
      "label": "Search APIs"
    },
    {
      "label": "Final results"
    },
    {
      "label": "Evaluation"
    },
    {
      "label": "Retained report"
    }
  ],
  "nodes": [
    {
      "id": "baseline",
      "label": "Baseline",
      "sublabel": "Frozen definition B",
      "stage": 0,
      "row": 0,
      "type": "database"
    },
    {
      "id": "candidate",
      "label": "Candidate",
      "sublabel": "Frozen definition C",
      "stage": 0,
      "row": 2,
      "type": "database"
    },
    {
      "id": "queries",
      "label": "Query set",
      "sublabel": "Same requests + context",
      "stage": 0,
      "row": 1,
      "type": "database"
    },
    {
      "id": "baselineapi",
      "label": "Baseline API",
      "sublabel": "Runs definition B",
      "stage": 1,
      "row": 0,
      "type": "backend",
      "width": 136
    },
    {
      "id": "candidateapi",
      "label": "Candidate API",
