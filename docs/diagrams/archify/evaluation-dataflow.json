      "label": "Pinned inputs",
      "route": "straight"
    },
    {
      "from": "queries",
      "to": "baselineapi",
      "label": "Original requests",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom",
      "via": [
        [
          100,
          214
        ],
        [
          315,
          214
        ]
      ]
    },
    {
      "from": "queries",
      "to": "candidateapi",
      "label": "Original requests",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "via": [
        [
          100,
          328
        ],
        [
          315,
          328
        ]
      ]
    },
    {
      "from": "baselineapi",
      "to": "baselineresults",
      "label": "Final rankings",
      "variant": "emphasis"
    },
    {
      "from": "candidateapi",
      "to": "candidateresults",
      "label": "Final rankings",
      "variant": "emphasis"
    },
    {
      "from": "baselineresults",
      "to": "evaluator",
      "label": "Baseline IDs",
      "variant": "emphasis"
    },
    {
      "from": "candidateresults",
      "to": "evaluator",
      "label": "Candidate IDs",
      "variant": "emphasis"
    },
    {
      "from": "judgements",
      "to": "evaluator",
      "label": "Ratings",
      "labelDy": 35
    },
    {
      "from": "evaluator",
      "to": "report",
      "label": "Scores + deltas",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "Each definition pins its inputs",
      "items": [
        "API image, query assets/config, index, dataset and engine version"
      ]
    },
    {
      "dot": "emerald",
      "title": "Resources may be shared",
      "items": [
        "Compatible definitions can reference one read-only index",
        "Both result sets retain their own fingerprint and diagnostics"
      ]
    }
  ]
