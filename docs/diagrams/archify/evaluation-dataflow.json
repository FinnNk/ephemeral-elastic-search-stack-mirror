{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Evaluate frozen Search API variants",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      620
    ]
  },
  "stages": [
    {
      "label": "Frozen definitions"
    },
    {
      "label": "Search APIs"
    },
    {
      "label": "Observations"
    },
    {
      "label": "Evaluation"
    },
    {
      "label": "Retained report"
    }
  ],
  "nodes": [
    {
      "id": "baseline",
      "label": "Baseline",
      "sublabel": "Named variant",
      "stage": 0,
      "row": 0,
      "type": "database"
    },
    {
      "id": "candidate",
      "label": "Variants",
      "sublabel": "One or more",
      "stage": 0,
      "row": 2,
      "type": "database"
    },
    {
      "id": "queries",
      "label": "Query suite",
      "sublabel": "Selected manifest SHA",
      "stage": 0,
      "row": 1,
      "type": "database"
    },
    {
      "id": "baselineapi",
      "label": "Baseline API",
      "sublabel": "Pinned environment",
      "stage": 1,
      "row": 0,
      "type": "backend",
      "width": 136
    },
    {
      "id": "candidateapi",
      "label": "API(s)",
