# Diagram receipts bind exact source and artifact bytes across operating systems.
docs/diagrams/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
lab/traffic/*.csv -text
lab/traffic/*.json -text
lab/gpu-worker/*.sh text eol=lf

# The inference protocol binds the kernel profile to its exact bytes.
judgements/esci/kernel-profile.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Quality confirmation binds the acceptance policy before opening outputs.
evaluation/specs/esci-label-quality-v1.json -text

# Source Actions checks these exact bytes against operator-configured pins.
lab/variant_gate.py text eol=lf
lab/delivery/policies/variant-merge-v1.json text eol=lf
lab/delivery/ci/lab_delivery.py text eol=lf
lab/delivery/ci/*.sh text eol=lf

# k3d executes this hook directly on Linux, including after Windows installation.
lab/oidc-node-startup.sh text eol=lf

# Fresh installation verifies these immutable manifest bytes before publication.
data/fresh-judgements/*.manifest.json -text

# The release contract requires a canonical version-file newline.
lab/delivery/bootstrap/VERSION text eol=lf

# Frozen query and judgement hashes must survive Windows and Mac checkouts.
lab/delivery/bootstrap/evaluation/** -text

# These exact Windows producer bytes are already bound into frozen identities.
# Preserve CRLF as content on every host; do not renormalise these files.
data/import_esci.py -text diff whitespace=cr-at-eol
lab/release_million.py -text diff whitespace=cr-at-eol
lab/profiles/esci-informed-uk-v1.json -text diff whitespace=cr-at-eol
judgements/noop_model.py -text diff whitespace=cr-at-eol
lab/search_target.py -text diff whitespace=cr-at-eol
lab/gatling/src/test/java/lab/relevance/SyntheticSearchSimulation.java -text diff whitespace=cr-at-eol

# Vendored upstream values are checked against their upstream byte checksums.
lab/headlamp-gateway/envoy-base-values.yaml -text
lab/headlamp-gateway/envoy-inference-values.yaml -text
