                          "aggregations": [
                            {
                              "metricName": "lab.operation.eligible",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum"
                            }
                          ],
                          "groupBy": [
                            {
                              "name": "lab.operation.kind"
                            }
                          ]
